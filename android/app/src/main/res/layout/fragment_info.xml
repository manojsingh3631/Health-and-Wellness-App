<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/deep_navy">

    <!-- ── Tab layout ── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_navy"
        app:tabIndicatorColor="@color/accent_blue"
        app:tabIndicatorHeight="3dp"
        app:tabTextColor="@color/muted_blue"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_faqs" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_rules" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_privacy" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_consent" />

    </com.google.android.material.tabs.TabLayout>

    <!-- ── Tab indicator divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ── ViewPager2 ── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
