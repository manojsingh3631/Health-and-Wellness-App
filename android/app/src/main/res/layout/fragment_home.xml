<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header row: greeting + streak badge ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Good morning,"
                android:textSize="16sp"
                android:textColor="@color/steel_blue"
                android:fontFamily="sans-serif"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_streak_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🔥 0 days"
                android:textSize="12sp"
                android:textColor="@color/amber"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:minHeight="28dp"
                android:gravity="center"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- ── User name ── -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="John Doe"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif"
            tools:ignore="HardcodedText" />

        <!-- ── Challenge card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/navy_card2"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_blue_translucent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Left: challenge name + days remaining -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_challenge_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spring Wellness Challenge"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="sans-serif"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/tv_days_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="18 days remaining"
                            android:textSize="12sp"
                            android:textColor="@color/steel_blue"
                            android:fontFamily="sans-serif"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <!-- Right: points value + label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tv_challenge_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1240"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:fontFamily="sans-serif"
                            android:gravity="end"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_points"
                            android:textSize="11sp"
                            android:textColor="@color/steel_blue"
                            android:fontFamily="sans-serif"
                            android:gravity="end" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Progress bar row -->
                <ProgressBar
                    android:id="@+id/pb_challenge_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:progress="55"
                    android:max="100"
                    android:progressTint="@color/teal"
                    android:progressBackgroundTint="@color/divider"
                    android:indeterminate="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_progress_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Day 12"
                        android:textSize="10sp"
                        android:textColor="@color/muted_blue"
                        android:fontFamily="sans-serif"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_progress_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Day 30"
                        android:textSize="10sp"
                        android:textColor="@color/muted_blue"
                        android:fontFamily="sans-serif"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Section: Today's Activities ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="TODAY'S ACTIVITIES"
            android:textSize="11sp"
            android:textColor="@color/muted_blue"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            tools:ignore="HardcodedText" />

        <!-- 3-column grid: steps, water, yoga -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:useDefaultMargins="false">

            <include
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <include
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />

        </GridLayout>

        <!-- 2-column grid: workout, sugar-free -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:rowCount="1"
            android:useDefaultMargins="false">

            <include
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />

            <include
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />

        </GridLayout>

        <!-- ── Nudge card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nudge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/blue_highlight_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_nudge_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_show_chart_24"
                    android:contentDescription="Nudge"
                    android:importantForAccessibility="no"
                    app:tint="@color/accent_blue"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nudge_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep it up!"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_nudge_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Log your activities to earn points today."
                        android:textSize="13sp"
                        android:textColor="@color/steel_blue"
                        android:fontFamily="sans-serif"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Section: This Week ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="THIS WEEK"
            android:textSize="11sp"
            android:textColor="@color/muted_blue"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            tools:ignore="HardcodedText" />

        <!-- Bar chart card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/navy_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Points This Week"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif"
                    tools:ignore="HardcodedText" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart_weekly"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Rank card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_rank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/navy_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR RANK"
                        android:textSize="10sp"
                        android:textColor="@color/muted_blue"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.08"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#5"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_board"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="View Board"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    app:strokeColor="@color/accent_blue"
                    app:cornerRadius="12dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
