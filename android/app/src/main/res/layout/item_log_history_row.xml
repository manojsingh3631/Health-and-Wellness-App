<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/navy_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:minHeight="52dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_log_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon, May 13"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tv_log_activities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Steps · Water · Yoga"
                android:textSize="11sp"
                android:textColor="@color/muted_blue"
                android:fontFamily="sans-serif"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_log_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+95 pts"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/teal"
            android:fontFamily="sans-serif"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
