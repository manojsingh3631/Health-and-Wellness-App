<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen window background.
    Layer 1: solid deep_navy fill.
    Layer 2: centered app logo tinted white (80dp × 80dp).
    Used by Theme.BluePondWellness.Splash via android:windowBackground.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/deep_navy" />
        </shape>
    </item>

    <!-- Centered launcher icon -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp"
        android:drawable="@mipmap/ic_launcher_foreground" />

</layer-list>
