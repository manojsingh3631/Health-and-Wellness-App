<?xml version="1.0" encoding="utf-8"?>
<!--
    Card border drawable — blue_highlight_bg fill, accent_blue 1dp stroke, 16dp corners.
    Used for nudge cards and highlighted info panels.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/blue_highlight_bg" />

    <stroke
        android:width="1dp"
        android:color="@color/accent_blue" />

    <corners android:radius="16dp" />

</shape>
