<?xml version="1.0" encoding="utf-8"?>
<!--
    Inactive chip background — transparent fill, muted_blue 1dp stroke, 20dp pill corners.
    Text color should be muted_blue / steel_blue when using this background.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="1dp"
        android:color="@color/muted_blue" />

    <corners android:radius="20dp" />

</shape>
